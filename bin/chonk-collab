#!/usr/bin/env python3
"""
chonk-collab — configure and observe Claude ↔ Codex review loops over shared markdown.

Subcommands:
    new <name> [--goal TEXT] [--project-dir DIR] [--force]
        Create a new collab file in the vault and wire the Stop hook into
        <project-dir>/.claude/settings.json (CWD by default). Merges with
        existing settings if present.

    watch [name]
        Live-tail a collab file. Re-renders on every file change. If name is
        omitted, auto-selects the single active collab, or errors if multiple.

    status [name] | list
        Print collab state (status, turn, turns_remaining, mtime).

    end [name]
        Manually mark a collab DONE (writes frontmatter, logs it, git-syncs).
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import date, datetime, timezone
from pathlib import Path

VAULT_ROOT = Path.home() / "code" / "obsidian"
PROJECTS_DIR = VAULT_ROOT / "02-Projects"
TEMPLATE_PATH = VAULT_ROOT / "Templates" / "agent-collab.md"
HOOK_PATH = Path.home() / ".claude" / "hooks" / "codex-review.py"
FINAL_STATES = {"APPROVED", "DONE", "ERROR"}


def die(msg: str, code: int = 1) -> None:
    sys.stderr.write(f"chonk-collab: {msg}\n")
    sys.exit(code)


def slugify(name: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9._-]+", "-", name.strip().lower()).strip("-")
    return s or "unnamed"


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def collab_file(name: str) -> Path:
    return PROJECTS_DIR / name / "agent-collab.md"


def parse_frontmatter(path: Path) -> tuple[dict, str]:
    text = path.read_text()
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}, text
    fm: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" in line and not line.lstrip().startswith("#"):
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
    return fm, text[end + 5 :]


def write_frontmatter(path: Path, fm: dict, body: str) -> None:
    fm_text = "\n".join(f"{k}: {v}" for k, v in fm.items())
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(f"---\n{fm_text}\n---\n{body}")
    tmp.replace(path)


def append_to_section(body: str, section: str, content: str) -> str:
    header = re.compile(rf"^##\s+{re.escape(section)}\s*$", re.MULTILINE)
    m = header.search(body)
    if not m:
        return body.rstrip() + f"\n\n## {section}\n\n{content}\n"
    after = body[m.end() :]
    next_m = re.search(r"^##\s+", after, re.MULTILINE)
    if next_m:
        insert_at = m.end() + next_m.start()
        return body[:insert_at].rstrip() + "\n\n" + content + "\n\n" + body[insert_at:]
    return body.rstrip() + "\n\n" + content + "\n"


def find_all_collabs() -> list[tuple[str, Path, dict]]:
    if not PROJECTS_DIR.exists():
        return []
    out: list[tuple[str, Path, dict]] = []
    for p in sorted(PROJECTS_DIR.glob("*/agent-collab.md")):
        fm, _ = parse_frontmatter(p)
        out.append((p.parent.name, p, fm))
    return out


def pick_collab(name: str | None, active_only: bool = True) -> tuple[str, Path, dict]:
    all_c = find_all_collabs()
    if name:
        name = slugify(name)
        for tup in all_c:
            if tup[0] == name:
                return tup
        die(f"no collab named '{name}' (looked in {PROJECTS_DIR})")

    if active_only:
        candidates = [c for c in all_c if c[2].get("status", "").upper() not in FINAL_STATES]
    else:
        candidates = all_c

    if not candidates:
        die("no active collabs found — start one with `chonk-collab new <name>`")
    if len(candidates) > 1:
        msg = ["multiple active collabs — specify by name:"]
        for (n, _, fm) in candidates:
            msg.append(f"  {n}  (status={fm.get('status','?')}, turn={fm.get('turn','?')})")
        die("\n".join(msg))
    return candidates[0]


# ---------- new ----------

def merge_settings(settings_path: Path, shared_file: Path) -> None:
    settings_path.parent.mkdir(parents=True, exist_ok=True)
    if settings_path.exists():
        try:
            settings = json.loads(settings_path.read_text())
        except json.JSONDecodeError:
            die(f"{settings_path} is not valid JSON — fix or move it, then retry")
    else:
        settings = {}

    env = settings.setdefault("env", {})
    env["CLAUDE_CODEX_SHARED_FILE"] = str(shared_file)

    hooks = settings.setdefault("hooks", {})
    stop_groups = hooks.setdefault("Stop", [])
    hook_cmd = str(HOOK_PATH)
    already = any(
        any(h.get("command") == hook_cmd for h in g.get("hooks", []))
        for g in stop_groups
    )
    if not already:
        stop_groups.append({"hooks": [{"type": "command", "command": hook_cmd}]})

    settings_path.write_text(json.dumps(settings, indent=2) + "\n")


def cmd_new(args: argparse.Namespace) -> None:
    if not TEMPLATE_PATH.exists():
        die(f"template missing at {TEMPLATE_PATH} — pull the vault or recreate it")
    if not HOOK_PATH.exists():
        die(f"hook script missing at {HOOK_PATH}")

    name = slugify(args.name)
    target = collab_file(name)
    if target.exists() and not args.force:
        die(f"{target} already exists — pass --force to overwrite")

    target.parent.mkdir(parents=True, exist_ok=True)
    text = TEMPLATE_PATH.read_text()
    today = date.today().isoformat()
    text = re.sub(r"^project: .*$", f"project: {name}", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^created: .*$", f"created: {today}", text, count=1, flags=re.MULTILINE)
    text = re.sub(r"^# Agent Collaboration:.*$",
                  f"# Agent Collaboration: {name}", text, count=1, flags=re.MULTILINE)

    if args.goal:
        text = re.sub(
            r"<one-paragraph statement.*?>",
            args.goal.strip(),
            text, count=1, flags=re.DOTALL,
        )
    if args.shared:
        text = re.sub(
            r"<context both agents need.*?>",
            args.shared.strip(),
            text, count=1, flags=re.DOTALL,
        )

    target.write_text(text)

    project_dir = Path(args.project_dir).expanduser().resolve()
    if not project_dir.is_dir():
        die(f"--project-dir {project_dir} is not a directory")
    settings_path = project_dir / ".claude" / "settings.json"
    merge_settings(settings_path, target)

    print(f"✓ Created   {target}")
    print(f"✓ Wired     {settings_path}")
    print()
    print("Next steps:")
    print(f"  cd {project_dir}")
    if not args.goal:
        print(f"  $EDITOR {target}    # fill in ## Goal and ## Shared")
    print(f"  claude")
    print()
    print("Then tell Claude:")
    print(f'  "Read {target.name} and follow the protocol.')
    print( '   Plan the work in the ## Plan section, then set')
    print( '   frontmatter status: READY_FOR_REVIEW and stop."')
    print()
    print(f"Watch live in another pane:  chonk-collab watch {name}")


# ---------- watch ----------

def cmd_watch(args: argparse.Namespace) -> None:
    name, path, _ = pick_collab(args.name, active_only=False)
    use_bat = shutil.which("bat") is not None
    last_mtime = 0.0
    try:
        while True:
            try:
                mtime = path.stat().st_mtime
            except FileNotFoundError:
                print(f"\n{path} vanished — ending watch", file=sys.stderr)
                return
            if mtime != last_mtime:
                last_mtime = mtime
                fm, _ = parse_frontmatter(path)
                os.system("clear")
                header = (
                    f"\033[1;36m═══ chonk-collab watch: {name} ═══\033[0m\n"
                    f"file:   {path}\n"
                    f"status: \033[1;33m{fm.get('status','?')}\033[0m   "
                    f"turn: \033[1;35m{fm.get('turn','?')}\033[0m   "
                    f"turns_left: {fm.get('turns_remaining','?')}\n"
                    f"updated: {datetime.fromtimestamp(mtime, tz=timezone.utc).strftime('%Y-%m-%d %H:%M:%SZ')}\n"
                )
                print(header)
                if use_bat:
                    subprocess.run(
                        ["bat", "--paging=never", "--style=plain",
                         "--language=md", "--color=always", str(path)],
                        check=False,
                    )
                else:
                    print(path.read_text())

                if fm.get("status", "").upper() in FINAL_STATES:
                    print(f"\n\033[1;32m[collab reached final state: {fm.get('status')}]\033[0m")
            time.sleep(1.5)
    except KeyboardInterrupt:
        print()


# ---------- status / list ----------

def cmd_status(args: argparse.Namespace) -> None:
    if getattr(args, "name", None):
        collabs = [pick_collab(args.name, active_only=False)]
    else:
        collabs = find_all_collabs()

    if not collabs:
        print("no collabs found")
        return

    print(f"{'NAME':<28} {'STATUS':<18} {'TURN':<8} {'LEFT':<5} UPDATED")
    for (n, p, fm) in collabs:
        mtime = datetime.fromtimestamp(p.stat().st_mtime, tz=timezone.utc)
        print(
            f"{n:<28} "
            f"{fm.get('status','?'):<18} "
            f"{fm.get('turn','?'):<8} "
            f"{fm.get('turns_remaining','?'):<5} "
            f"{mtime.strftime('%Y-%m-%d %H:%M:%SZ')}"
        )


# ---------- end ----------

def cmd_end(args: argparse.Namespace) -> None:
    name, path, _ = pick_collab(args.name)
    fm, body = parse_frontmatter(path)
    fm["status"] = "DONE"
    fm["turn"] = "done"
    body = append_to_section(
        body, "Log", f"- {now_iso()} **user**: manually ended via `chonk-collab end`"
    )
    write_frontmatter(path, fm, body)
    git_sync(path, f"agent-collab ({name}): manually ended")
    print(f"✓ Ended {name} — {path}")


def git_sync(path: Path, message: str) -> None:
    """Best-effort: stage, commit, push just this file. Never raises."""
    try:
        root = next((p for p in [path, *path.parents] if (p / ".git").exists()), None)
        if not root:
            return
        rel = path.relative_to(root)
        subprocess.run(["git", "-C", str(root), "add", str(rel)],
                       check=False, timeout=10,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        r = subprocess.run(["git", "-C", str(root), "commit", "-m", message, "--", str(rel)],
                           capture_output=True, text=True, timeout=10)
        if r.returncode != 0 and "nothing to commit" not in (r.stdout + r.stderr):
            return
        subprocess.run(["git", "-C", str(root), "push"],
                       check=False, timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


# ---------- main ----------

def main() -> None:
    ap = argparse.ArgumentParser(prog="chonk-collab",
                                 description="Claude ↔ Codex review loop over shared markdown.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_new = sub.add_parser("new", help="create a new collab + wire Stop hook")
    p_new.add_argument("name", help="project slug (kebab-case)")
    p_new.add_argument("--goal", help="inline ## Goal text")
    p_new.add_argument("--shared", help="inline ## Shared context")
    p_new.add_argument("--project-dir", default=os.getcwd(),
                       help="where to write .claude/settings.json (default: CWD)")
    p_new.add_argument("--force", action="store_true",
                       help="overwrite existing collab file")
    p_new.set_defaults(func=cmd_new)

    p_watch = sub.add_parser("watch", help="live-tail a collab file")
    p_watch.add_argument("name", nargs="?", help="collab name (default: only active)")
    p_watch.set_defaults(func=cmd_watch)

    p_status = sub.add_parser("status", help="show collab state")
    p_status.add_argument("name", nargs="?")
    p_status.set_defaults(func=cmd_status)

    p_list = sub.add_parser("list", help="list all collabs")
    p_list.set_defaults(func=cmd_status, name=None)

    p_end = sub.add_parser("end", help="manually mark a collab DONE")
    p_end.add_argument("name", nargs="?")
    p_end.set_defaults(func=cmd_end)

    args = ap.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
