# Font
font-family = MesloLGS Nerd Font
font-size = 14

# Theme - Catppuccin Mocha (easy on the eyes, great contrast)
theme = Catppuccin Mocha

# Window
window-padding-x = 8
window-padding-y = 4
window-decoration = true

# Shell integration
shell-integration = zsh

# Cursor
cursor-style = bar
cursor-style-blink = true

# macOS specific
macos-option-as-alt = true
